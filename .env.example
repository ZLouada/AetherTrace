# ==============================================================================
# AetherTrace Environment Configuration
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment.
# All settings have safe local defaults. None are mandatory for local testing.

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
# Port for the AetherTrace Interceptor Proxy and Telemetry Bus
# Default: 4000
PORT=4000

# Path to the SQLite trace database file
# Default: .trace.sqlite in current working directory
AETHERTRACE_DB_PATH=.trace.sqlite

# ------------------------------------------------------------------------------
# Upstream LLM Configuration (Optional)
# ------------------------------------------------------------------------------
# Upstream API key used if the client does not send an Authorization header
# Optional: Clients can provide Authorization: Bearer <key> per-request
# OPENAI_API_KEY=

# Base URL for upstream OpenAI-compatible model providers
# Default: https://api.openai.com/v1
# Example for local Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Enable global mock mode ($0.00 spend simulation without upstream calls)
# Default: false
AETHERTRACE_MOCK=false

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Optional local authentication token.
# When set, all incoming requests (except /health) must provide:
# Authorization: Bearer <token> or X-AetherTrace-Token: <token>
# Default: (none - open for local developer workstation)
# AETHERTRACE_AUTH_TOKEN=

# Comma-separated list of additional allowed CORS origins
# Default: http://localhost:3000,http://127.0.0.1:3000
# AETHERTRACE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Allow private network and loopback IP targets in SSRF shield
# CAUTION: Setting to true allows proxying to 127.0.0.1 and private subnets.
# Default: false (enforces strict private IP blocking)
AETHERTRACE_ALLOW_PRIVATE_NETWORK=false

# ------------------------------------------------------------------------------
# Flight Deck UI Configuration (Optional)
# ------------------------------------------------------------------------------
# Proxy REST API endpoint accessible from the browser
# Default: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Telemetry WebSocket endpoint accessible from the browser
# Default: ws://localhost:4000/ws
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
